TWINLY_API_KEY=
TWINLY_BASE=https://advktwnedlgnhswpxokg.supabase.co/functions/v1/twinly-api/v1
OPENAI_API_KEY=
DECISIONS_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
ASR_SIZE=turbo
MOCK=0
DECISIONS_ENABLED=1
KEEP_AUDIO=0
DEV=0
HOST=127.0.0.1
PORT=8000
GEMMA_TIMEOUT_S=12
GEMMA_BUDGET_S=20
JOB_DEADLINE_S=90
# Accounts groundwork (off by default; see docs/md/10 "Accounts")
AUTH_ENABLED=0
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=
ENCRYPTION_KEY=
PROFILE_STORE=sqlite

# ---- Call (supplementary feature; see docs/CALL.md) ----
# The variables above this line are older and are not all read by lib/config.mjs.
# Names and defaults below match lib/config.mjs.
CALL_TOKEN=change-me-to-a-long-random-string
CALL_PARTICIPANTS=aryan,rohit
# Optional per-person Twinly keys; each falls back to TWINLY_API_KEY when empty.
TWINLY_API_KEY_ARYAN=
TWINLY_API_KEY_ROHIT=
CALL_MAX_LINES=40
# Set to 1 only behind the cloudflared tunnel (scripts/call-tunnel.sh does this for you).
TRUST_PROXY=0
