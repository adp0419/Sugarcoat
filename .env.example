# Live pipeline: Groq transcription -> Google Gemma cleanup -> Twinly voice.
# Fill in these three server-side keys, then restart with npm start.
GROQ_API_KEY=
GOOGLE_API_KEY=
TWINLY_API_KEY=

# Runtime
APP_MODE=live
TTS_PROVIDER=twinly
HOST=127.0.0.1
PORT=8000
APP_ORIGIN=http://127.0.0.1:8000

# Groq speech recognition; leave STT_LANGUAGE empty for automatic detection.
GROQ_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# Gemma uses a Google AI Studio key in GOOGLE_API_KEY.
GOOGLE_MODEL=gemma-4-26b-a4b-it
GOOGLE_STREAM=false
GOOGLE_THINKING_CONFIG={"thinkingLevel":"minimal"}

# Twinly uses the key owner's existing voice clone; no voice ID is needed.
TWINLY_API_BASE_URL=https://advktwnedlgnhswpxokg.supabase.co/functions/v1/twinly-api/v1

# Request limits and bounded retries (milliseconds unless stated otherwise).
MAX_AUDIO_BYTES=4194304
MAX_RECORD_SECONDS=60
REQUEST_TIMEOUT_MS=25000
MAX_RETRIES=1
MAX_RETRY_DELAY_MS=1000
MAX_CONCURRENT_REQUESTS=4
MAX_TTS_BYTES=12582912

# Optional silence detection; 0 disables automatic stopping.
VAD_SILENCE_MS=0
VAD_RMS_THRESHOLD=0.015

# ---- Call / Comms page (see docs/CALL.md) ----
CALL_TOKEN=change-me-to-a-long-random-string
CALL_PARTICIPANTS=aryan,rohit
# Optional per-person Twinly keys; each falls back to TWINLY_API_KEY when empty.
TWINLY_API_KEY_ARYAN=
TWINLY_API_KEY_ROHIT=
CALL_MAX_LINES=40
# Set to 1 only behind the cloudflared tunnel (scripts/call-tunnel.sh does this for you).
TRUST_PROXY=0

# ---- Supabase (Settings → API). The service-role key is server-only; never expose it to the browser. ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth / accounts ----
# Encrypts stored Twinly keys (AES-256-GCM). Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Allowlist: handle:email pairs. Only these accounts can sign in.
CALL_USERS=aryan:you@example.com,rohit:partner@example.com
